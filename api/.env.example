# Used by docker-compose.yaml to configure the db and app services.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=houses

# Used when running the API directly with `uv run`, outside Docker Compose.
# Compose publishes Postgres on host port 5433, so start the db service first.
DB_CONN=postgresql+psycopg://postgres:postgres@localhost:5433/houses
